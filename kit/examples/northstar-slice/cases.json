{
  "name": "Northstar slice: 20 cases",
  "mocks": {
    "get_order": {"order_id": "O100", "customer_id": "C1", "status": "processing", "total": 24.0},
    "list_customer_orders": [{"order_id": "O100", "status": "processing"}],
    "find_order_shipments": [{"shipment_id": "S1", "order_id": "O101"}],
    "track_parcel": {"shipment_id": "S1", "status": "in_transit", "tracking": "NS-55821"},
    "find_order_invoices": [{"invoice_id": "I1", "order_id": "O100"}],
    "get_invoice_balance": {"invoice_id": "I1", "balance": 0.0},
    "search_customers": [{"customer_id": "C1", "name": "Alex Lee", "tier": "gold"}],
    "get_return_refund_quote": {"return_id": "R1", "refund": 18.0, "fee": 2.0}
  },
  "cases": [
    {"id": "orders-read", "type": "single", "category": "orders",
     "prompt": "Pull up the full record for order O100.",
     "expect": {"tools": ["get_order"], "args": {"get_order": {"order_id": "O100"}}, "forbidden": ["list_customer_orders"]}},
    {"id": "orders-by-customer", "type": "single", "category": "orders",
     "prompt": "Which orders has customer C2 placed with us?",
     "expect": {"tools": ["list_customer_orders"], "args": {"list_customer_orders": {"customer_id": "C2"}}}},
    {"id": "address-order", "type": "single", "category": "orders",
     "prompt": "Order O100 hasn't left the warehouse yet. Please change where it will be delivered to 12 Elm Street.",
     "expect": {"tools": ["set_order_address"], "args": {"set_order_address": {"order_id": "O100", "address": "12 Elm Street"}}, "forbidden": ["set_parcel_address", "set_customer_address"]}},
    {"id": "address-parcel", "type": "single", "category": "shipping",
     "prompt": "Parcel S1 is already on its way; redirect it to 9 Harbor Road.",
     "expect": {"tools": ["set_parcel_address"], "args": {"set_parcel_address": {"shipment_id": "S1", "address": "9 Harbor Road"}}, "forbidden": ["set_order_address", "set_customer_address"]}},
    {"id": "address-customer", "type": "single", "category": "customers",
     "prompt": "Customer C1 has moved. Their default address is now 4 Pine Court; leave existing orders as they are.",
     "expect": {"tools": ["set_customer_address"], "args": {"set_customer_address": {"customer_id": "C1", "address": "4 Pine Court"}}, "forbidden": ["set_order_address", "set_parcel_address"]}},
    {"id": "parcel-status", "type": "single", "category": "shipping",
     "prompt": "Where is shipment S1 right now, and what's its tracking number?",
     "expect": {"tools": ["track_parcel"], "args": {"track_parcel": {"shipment_id": "S1"}}}},
    {"id": "invoice-owed", "type": "single", "category": "billing",
     "prompt": "How much is still owed on invoice I2?",
     "expect": {"tools": ["get_invoice_balance"], "args": {"get_invoice_balance": {"invoice_id": "I2"}}}},
    {"id": "goodwill-credit", "type": "single", "category": "customers",
     "prompt": "Give customer C2 a $15 goodwill credit to spend in the shop. Don't touch their card payment.",
     "expect": {"tools": ["issue_store_credit"], "args": {"issue_store_credit": {"customer_id": "C2", "amount": 15}}, "forbidden": ["refund_payment"]}},
    {"id": "refund-invoice", "type": "single", "category": "billing",
     "prompt": "Send $12 of the captured payment on invoice I1 back to the customer's card.",
     "expect": {"tools": ["refund_payment"], "args": {"refund_payment": {"invoice_id": "I1", "amount": 12}}, "forbidden": ["issue_store_credit"]}},
    {"id": "approve-return", "type": "single", "category": "returns",
     "prompt": "Approve return request R1 so the customer can send the bag back.",
     "expect": {"tools": ["authorize_return"], "args": {"authorize_return": {"return_id": "R1"}}, "forbidden": ["refund_payment"]}},
    {"id": "return-value", "type": "single", "category": "returns",
     "prompt": "If we accept return R1, how much would the customer get back after the restocking fee?",
     "expect": {"tools": ["get_return_refund_quote"], "args": {"get_return_refund_quote": {"return_id": "R1"}}, "forbidden": ["refund_payment"]}},
    {"id": "stop-order", "type": "single", "category": "orders",
     "prompt": "The buyer of order O101 changed their mind before it shipped. Call the whole order off.",
     "expect": {"tools": ["cancel_order"], "args": {"cancel_order": {"order_id": "O101"}}, "forbidden": ["refund_payment"]}},
    {"id": "order-delivery-status", "type": "multi-step", "category": "shipping",
     "prompt": "What's the delivery status of the parcel for order O101?",
     "expect": {"tools": ["find_order_shipments", "track_parcel"], "ordered": true, "args": {"find_order_shipments": {"order_id": "O101"}, "track_parcel": {"shipment_id": "S1"}}}},
    {"id": "order-balance", "type": "multi-step", "category": "billing",
     "prompt": "What's the outstanding balance on the bill for order O100?",
     "expect": {"tools": ["find_order_invoices", "get_invoice_balance"], "ordered": true, "args": {"get_invoice_balance": {"invoice_id": "I1"}}, "allowed": ["get_order"]}},
    {"id": "damaged-refund", "type": "multi-step", "category": "billing",
     "prompt": "Order O100 arrived damaged. Refund $12 of what the customer paid for it.",
     "expect": {"tools": ["find_order_invoices", "refund_payment"], "ordered": true, "args": {"refund_payment": {"invoice_id": "I1", "amount": 12}}, "allowed": ["get_order"], "forbidden": ["issue_store_credit", "authorize_return"]}},
    {"id": "customer-orders-by-name", "type": "multi-step", "category": "customers",
     "prompt": "Find our gold-tier customer called Lee and show me what orders they have.",
     "expect": {"tools": ["search_customers", "list_customer_orders"], "ordered": true, "args": {"search_customers": {"name": "Lee"}, "list_customer_orders": {"customer_id": "C1"}}}},
    {"id": "email-unsupported", "type": "unsupported", "category": "shipping",
     "prompt": "Email customer C2 a notification that parcel S1 is out for delivery.",
     "expect": {"tools": []}},
    {"id": "export-unsupported", "type": "unsupported", "category": "customers",
     "prompt": "Export every customer's order history to a CSV file for the accountants.",
     "expect": {"tools": []}},
    {"id": "address-ambiguous", "type": "ambiguous", "category": "orders",
     "prompt": "Change the delivery address to 5 Main Street.",
     "notes": "No order, parcel or customer is named: the agent should ask which one.",
     "expect": {"tools": [], "forbidden": ["set_order_address", "set_parcel_address", "set_customer_address"]}},
    {"id": "refund-ambiguous", "type": "ambiguous", "category": "billing",
     "prompt": "Refund the customer for their order.",
     "notes": "No customer, order or amount: looking things up is fine, refunding is not.",
     "expect": {"tools": [], "allowed": ["get_order", "list_customer_orders", "search_customers", "find_order_invoices"], "forbidden": ["refund_payment", "issue_store_credit"]}}
  ]
}
